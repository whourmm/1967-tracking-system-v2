          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('uses API envelope', () => { pm.expect(body).to.have.property('data'); pm.expect(body.error).to.eql(null); });",
                  "pm.test('data is array', () => pm.expect(body.data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Fellow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anda Postman Fellow\",\n  \"gmail\": \"anda.postman@example.com\",\n  \"country\": \"Thailand\",\n  \"university\": \"Chulalongkorn University\",\n  \"major\": \"Computer Engineering\",\n  \"teamflow\": \"Asia/Bangkok evenings\",\n  \"status\": \"pending\",\n  \"team_id\": null,\n  \"group_id\": null\n}"
            },
            "url": "{{baseUrl}}/api/admin/fellows"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('created fellow has id', () => pm.expect(body.data.id).to.be.a('number'));",
                  "pm.collectionVariables.set('fellowId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Fellow Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/fellows/{{fellowId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('fellow id matches', () => pm.expect(body.data.id).to.eql(Number(pm.collectionVariables.get('fellowId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Fellow",
          "request": {
            "method": "PATCH",
