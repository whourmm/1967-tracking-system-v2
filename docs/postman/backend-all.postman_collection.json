    {
      "name": "01 - Availability and authentication",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('health is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Supabase login - admin",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabaseKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get('adminToken') || !pm.variables.get('adminEmail') || !pm.variables.get('adminPassword')) pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supabase login succeeded', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('admin access token returned', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
                  "pm.environment.set('adminToken', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Supabase login - fellow",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabaseKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{fellowEmail}}\",\n  \"password\": \"{{fellowPassword}}\"\n}"
            },
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get('fellowToken') || !pm.variables.get('fellowEmail') || !pm.variables.get('fellowPassword')) pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supabase login succeeded', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('fellow access token returned', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
                  "pm.environment.set('fellowToken', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Protected route rejects missing token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
