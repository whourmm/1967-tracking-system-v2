    {
      "name": "04 - Full write tests (guarded)",
      "description": "Skipped unless runMutations=true. Run this folder in order. Temporary data is removed except the assignment, because the API has no assignment-delete route.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (String(pm.variables.get('runMutations')) !== 'true') pm.execution.skipRequest();"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Create temporary fellow",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Temporary Fellow\",\n  \"gmail\": \"postman-{{$guid}}@example.com\",\n  \"country\": \"Thailand\",\n  \"university\": \"Postman Test University\",\n  \"major\": \"API Testing\",\n  \"teamflow\": \"temporary\",\n  \"status\": \"pending\",\n  \"team_id\": null,\n  \"group_id\": null\n}"
            },
            "url": "{{baseUrl}}/api/admin/fellows"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('created fellow has id', () => pm.expect(body.data.id).to.be.a('number'));",
              "pm.collectionVariables.set('createdFellowId', body.data.id);"
            ]}
          }]
        },
        {
          "name": "Get temporary fellow",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/fellows/{{createdFellowId}}" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('fellow id matches', () => pm.expect(pm.response.json().data.id).to.eql(Number(pm.variables.get('createdFellowId'))));"
            ]}
          }]
        },
        {
          "name": "Update temporary fellow",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
